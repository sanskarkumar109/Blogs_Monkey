# Django Core Settings
SECRET_KEY=change-me-to-a-secure-random-64-character-string-in-production
DEBUG=False
ALLOWED_HOSTS=yourdomain.com,www.yourdomain.com,127.0.0.1,localhost

# Database Settings (Local / Production Environment Switcher)
# Set DB_ENV to 'local' for local development or 'production' for cloud deployment
DB_ENV=local
DB_ENGINE=django.db.backends.mysql

# Local MySQL Database Settings
LOCAL_DB_NAME=blog_saas_db
LOCAL_DB_USER=root
LOCAL_DB_PASSWORD=root
LOCAL_DB_HOST=127.0.0.1
LOCAL_DB_PORT=3306

# Production MySQL Database Settings (Aiven Cloud / Remote VPS)
PROD_DB_NAME=your_production_database
PROD_DB_USER=avnadmin
PROD_DB_PASSWORD=your_production_password
PROD_DB_HOST=your_aiven_host.aivencloud.com
PROD_DB_PORT=10420

# Email Settings (SMTP)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.sendgrid.net
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=apikey
EMAIL_HOST_PASSWORD=your_email_provider_api_key_or_password
DEFAULT_FROM_EMAIL=SaaS Blog Platform <noreply@yourdomain.com>

# Cache Settings (Redis - Optional)
REDIS_URL=redis://127.0.0.1:6379/1

# Media Storage Settings (Required for Vercel / Serverless deployments)
# Option A: Cloudinary (Free & recommended for Vercel)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Option B: AWS S3 / Cloudflare R2
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_STORAGE_BUCKET_NAME=your-bucket-name
AWS_S3_REGION_NAME=us-east-1

# JWT Authentication
JWT_SECRET_KEY=change-me-to-a-secure-jwt-signing-key

# Security & CORS
CORS_ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# AI Infrastructure (OpenRouter Gateway)
AI_PROVIDER=openrouter
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
AI_MODEL=openai/gpt-4o-mini
AI_TEMPERATURE=0.7
AI_MAX_TOKENS=2000
AI_RATE_LIMIT_PER_MINUTE=20

